# Shared by every repository in github.com/aukam-dev (see aukam-dev/repo-template).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml,js,mjs,cjs,ts,tsx,astro,css,html,svg}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
